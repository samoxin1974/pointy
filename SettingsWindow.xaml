<Window x:Class="Pointy.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pointy" Width="800" Height="640" MinWidth="720" MinHeight="540"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize" FontFamily="Segoe UI" FontSize="12.5"
        Foreground="{StaticResource Text}" UseLayoutRounding="True">

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,18">
            <Image x:Name="AppIcon" Width="46" Height="46" VerticalAlignment="Center" />
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Pointy" FontSize="23" FontWeight="SemiBold" />
                <TextBlock Text="A hand on a stick instead of your mouse pointer."
                           Foreground="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="POINTER" Style="{StaticResource Section}" />
                <Border Style="{StaticResource Row}" Padding="6" Margin="0,0,0,0">
                    <ListBox x:Name="StyleList" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             SelectionChanged="StyleList_SelectionChanged">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="78" Margin="3">
                                    <Border Background="#F1F1F4" CornerRadius="10" Height="68" Padding="6">
                                        <Image Source="{Binding Thumb}" Stretch="Uniform" />
                                    </Border>
                                    <TextBlock Text="{Binding Title}" FontSize="10" Margin="0,4,0,0"
                                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </DockPanel>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="APPEARANCE" Style="{StaticResource Section}" />
                    <Border Style="{StaticResource Row}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="Size" VerticalAlignment="Center" />
                                <TextBlock x:Name="SizeText" DockPanel.Dock="Right" VerticalAlignment="Center"
                                           Foreground="{StaticResource Muted}" FontSize="11" />
                            </DockPanel>
                            <Slider x:Name="SizeSlider" Minimum="0.08" Maximum="0.20"
                                    SmallChange="0.005" LargeChange="0.02" Margin="0,6,0,10"
                                    ValueChanged="SizeSlider_ValueChanged" />
                            <CheckBox x:Name="ShadowCheck" Content="Drop shadow"
                                      Click="ShadowCheck_Click" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="INK" Style="{StaticResource Section}" Margin="0,6,0,8" />
                    <Border Style="{StaticResource Row}">
                        <DockPanel>
                            <TextBlock Text="Colour" VerticalAlignment="Center" />
                            <ComboBox x:Name="InkBox" HorizontalAlignment="Right"
                                      SelectionChanged="InkBox_SelectionChanged" />
                        </DockPanel>
                    </Border>

                    <TextBlock Text="SOUND" Style="{StaticResource Section}" Margin="0,6,0,8" />
                    <Border Style="{StaticResource Row}">
                        <StackPanel>
                            <CheckBox x:Name="SoundCheck" Content="Tap sound" Margin="0,0,0,10"
                                      Click="SoundCheck_Click" />
                            <DockPanel>
                                <TextBlock Text="Clip" VerticalAlignment="Center" />
                                <ComboBox x:Name="TapSoundBox" HorizontalAlignment="Right"
                                          SelectionChanged="TapSoundBox_SelectionChanged" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="BEHAVIOUR" Style="{StaticResource Section}" Margin="0,6,0,8" />
                    <Border Style="{StaticResource Row}">
                        <DockPanel>
                            <TextBlock Text="Hold to click for real" VerticalAlignment="Center" />
                            <ComboBox x:Name="InteractBox" HorizontalAlignment="Right" MinWidth="92"
                                      SelectionChanged="InteractBox_SelectionChanged" />
                        </DockPanel>
                    </Border>

                    <TextBlock Text="SHORTCUTS" Style="{StaticResource Section}" Margin="0,6,0,8" />
                    <Border Style="{StaticResource Row}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Turn pointer on / off" VerticalAlignment="Center" />
                                <TextBox x:Name="ToggleHotkeyBox" Width="120" HorizontalAlignment="Right"
                                         VerticalContentAlignment="Center" LostFocus="Hotkey_LostFocus" />
                            </DockPanel>
                            <DockPanel>
                                <TextBlock Text="Clear drawing" VerticalAlignment="Center" />
                                <TextBox x:Name="ClearHotkeyBox" Width="120" HorizontalAlignment="Right"
                                         VerticalContentAlignment="Center" LostFocus="Hotkey_LostFocus" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="SYSTEM" Style="{StaticResource Section}" Margin="0,6,0,8" />
                    <Border Style="{StaticResource Row}">
                        <CheckBox x:Name="LaunchCheck" Content="Start Pointy when I sign in"
                                  Click="LaunchCheck_Click" />
                    </Border>

                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11"
                               Margin="2,6,0,10"
                               Text="Left click taps and drag draws. Hold the key above to use the real pointer, and press Esc to turn Pointy off." />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,18,0,0">
            <Button Content="Close" Width="96" Height="30" DockPanel.Dock="Right"
                    IsCancel="True" Click="Close_Click" />
        </DockPanel>
    </Grid>
</Window>
